# golbang systemd units read this via EnvironmentFile=-/etc/golbang/secrets.env
# Copy to /etc/golbang/secrets.env, fill real keys, then:  chmod 600 /etc/golbang/secrets.env
#
# Used by --api-key "${GOLBANG_API_KEY}" in deploy/*.service
GOLBANG_API_KEY=change-me
# Second key for units that must not share the primary key (e.g. glm53flash)
GOLBANG_API_KEY_GLM53=change-me-too
