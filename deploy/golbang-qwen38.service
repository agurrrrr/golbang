[Unit]
Description=golbang OpenAI server - Qwen3.8-27B UD-Q4_K_XL 230k q8_0 KV (MI50)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-deepseek.service golbang-qwen48.service golbang-glm53flash.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
EnvironmentFile=-/etc/golbang/secrets.env
Environment=HSA_OVERRIDE_GFX_VERSION=9.0.6
Environment=ROCR_VISIBLE_DEVICES=0
Environment=ROCBLAS_USE_HIPBLASLT=0
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-glm5next/build/bin
Environment=RUST_LOG=info
# Sampling: Qwen3.8-27B thinking-mode card (temperature 1.0 / top_p 0.95 / top_k 20).
# The model runs thinking-first here (--reasoning-effort xhigh), and the web UI
# omits sampling fields, so these server defaults are what chat clients get.
# Clients may still override each field per request.
ExecStartPre=/usr/bin/sudo /home/agurrrrr/code/local-llm/set_gpu_clocks.sh
ExecStart=/home/agurrrrr/code/golbang/target-hip/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-UD-Q4_K_XL.gguf \
  --alias qwen3.8-27b-hip \
  --host 0.0.0.0 --port 8083 \
  --n-gpu-layers 99 --flash-attn on \
  --n-ctx 100000 --n-batch 2048 --n-ubatch 512 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 2 --queue-size 2 --single-max-ctx 100000 --kv-unified \
  --kv-type-k q8_0 --kv-type-v q8_0 \
  --no-mmap --jinja --reasoning-format deepseek \
  --reasoning-effort xhigh --reasoning-budget 4096 \
  --temperature 1.0 --top-p 0.95 --top-k 20 \
  --mmproj /home/agurrrrr/models/qwen3.8/mmproj-F16.gguf \
  --spec-type draft-mtp,ngram-mod \
  --spec-draft-n-max 3 \
  --spec-draft-p-min 0.9 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --api-key "${GOLBANG_API_KEY}"
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target
