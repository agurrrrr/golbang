[Unit]
Description=golbang OpenAI server - Qwen3.8-27B Q6_K (MI50)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-deepseek.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HSA_OVERRIDE_GFX_VERSION=9.0.6
Environment=ROCR_VISIBLE_DEVICES=0
Environment=ROCBLAS_USE_HIPBLASLT=0
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-upgrade/build/bin
Environment=RUST_LOG=info
ExecStartPre=/usr/bin/sudo /home/agurrrrr/code/local-llm/set_gpu_clocks.sh
ExecStart=/home/agurrrrr/code/golbang/target/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-Q6_K.gguf \
  --alias qwen3.8-27b-q6 \
  --host 0.0.0.0 --port 8083 \
  --n-gpu-layers 99 --flash-attn on \
  --n-ctx 40000 --n-batch 2048 --n-ubatch 2048 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 2 --queue-size 2 \
  --no-mmap --jinja --reasoning-format deepseek \
  --reasoning-effort medium --reasoning-budget 2048 \
  --mmproj /home/agurrrrr/models/qwen3.8/mmproj-F16.gguf \
  --spec-type draft-mtp,ngram-mod \
  --spec-draft-n-max 3 \
  --spec-draft-p-min 0.90 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target
