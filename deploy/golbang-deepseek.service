[Unit]
Description=golbang OpenAI server - DeepSeek-V4-Flash-0731 UD-IQ2_M (MI50)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-qwen38.service golbang-qwen48.service golbang-glm53flash.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HSA_OVERRIDE_GFX_VERSION=9.0.6
Environment=ROCR_VISIBLE_DEVICES=0
Environment=ROCBLAS_USE_HIPBLASLT=0
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-glm5next/build/bin
Environment=RUST_LOG=info
# DeepSeek-V4-Flash-0731 UD-IQ2_M (arch deepseek4), 3 shards, 84.68 GiB.
# Reverted from the DSV4.1-Flash Q2_K experiment (too slow for daily use).
# Shards live on the local NVMe (/home), not the NAS: NFS mmap load took ~7.5 min
# and thrashed under cgroup MemoryMax. DSV4.1 moved the other way (NAS + symlink).
# n-cpu-moe 32: pins expert weights of the FIRST 32 layers to CPU, keeping the
# rest on the 32 GiB MI50. n-ubatch=1024: ubatch=5800 compute OOMs next to 60k KV.
# TimeoutStartSec=300: 84 GiB mmap load.
ExecStart=/home/agurrrrr/code/golbang/target-hip/release/golbang-server \
  --model /home/agurrrrr/models/dsv4/UD-IQ2_M/DeepSeek-V4-Flash-0731-UD-IQ2_M-00001-of-00003.gguf \
  --alias deepseek-v4-flash-0731 \
  --host 0.0.0.0 --port 8080 \
  --n-gpu-layers 99 --n-cpu-moe 32 --flash-attn on \
  --n-ctx 60000 --n-batch 5800 --n-ubatch 1024 --n-threads 32 --n-rs-seq 1 \
  --n-parallel 1 --queue-size 1 \
  --jinja --reasoning-format deepseek \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target
