[Unit]
Description=golbang OpenAI server - Qwen3.8-Flash-Next UD-Q4_K_XL (2x V100 CUDA, experts on CPU)
After=network.target
Conflicts=golbang-cuda-qwen38.service qwen3.8-q2.service comfyui-cuda.service qwen3.8-unleashed-q2.service golbang-glm53flash.service ggml-rpc-v100.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
EnvironmentFile=-/etc/golbang/secrets.env
Environment=HOME=/home/agurrrrr
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-cuda-upstream/build/bin:/opt/cuda-12.8/lib64
Environment=RUST_LOG=info
# Qwen3.8-Flash-Next (arch qwen4exp, 176.94 B, 6 B active) UD-Q4_K_XL, 4 shards.
# mmap is mandatory: the PLE n-gram table (per_layer_token_embd, 27.4 GiB) is
# TENSOR_READ_LAZY and is gathered from the mapping row by row. Do NOT pass
# --no-mmap, or the whole 27.4 GiB table is loaded into RAM.
# n-cpu-moe 42 with a *shifted* tensor-split (11,1) keeps experts of layers 42..47
# on the V100s: the proportional split boundary lands at layer 44, so GPU0 carries
# dense layers 0..43 and GPU1 carries the tail experts. Experts are the tail, so a
# symmetric split (16,16) puts every GPU expert on one card and silently spills the
# other. Load with 42/11,1 = GPU0 ~14.3 GiB, GPU1 ~9.4 GiB.
# --n-ubatch 2048 is the prefill lever: 512 -> 1024 -> 2048 lifts 80k-token prefill
# from 102 to 234 tok/s at identical decode. ub 4096 fails at load (`llama_init_from_model
# returned null`), so 2048 is the ceiling on 2x16 GiB. To let the server find the
# ceiling itself, add --kv-pool-fit: on load failure it retries with a halved
# n_ubatch (then n_ctx) and exports the effective values as golbang_pool_* gauges.
# --spec-type ngram-mod is a loss here: acceptance ~0.20 and decode drops to 7-15 tok/s
# because verifying a draft span activates the union of CPU experts. Leave it off.
# MTP (`-md` + draft-mtp) is a win on this tree: the external Unsloth
# `mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf` (2.6 GiB, borrows token_embd/output)
# gives acceptance 0.98-1.00, decode 1.20x short (~23 -> ~28 tok/s) and 1.05x at
# ~15k ctx (~21 -> ~22 tok/s). Verifying a draft span batches several tokens, which
# offsets the CPU expert union cost. Output is valid but not bit-identical to
# no-spec greedy (batched-verify numerics). Needs the PR #28243 runtime
# (EXPECTED_SHA_CUDA 1c4cfda6c); the draft rides on CUDA1 (~5.4 GiB, ~2 GiB free).
# Prompt lookup (`--spec-type draft-mtp,prompt-lookup`, #247) copies the tail of
# an earlier suffix. On this unit it lifts copy-heavy mean accepted length
# 2.99 -> 3.72 but decode only 35.4 -> 35.8 tok/s (+1.1%) because the verify
# batch grows 3 -> 4 and CPU experts cancel the gain; prose is flat. Left off by
# default. If enabled, n_rs_seq is raised to max(n_max, pld_k) automatically --
# without that the scheduler snapshots 115 MiB every verify step (35 -> 19 t/s).
# See docs/bench/pld-flashnext.md.
# n-threads 16 vs 32 is noise.
# Measured on 2x V100 + EPYC 7452 (mmap, page cache warm):
#   prefill 234 tok/s @ 80k prompt (258 tok/s @ 7k), decode ~22 tok/s short / ~15.4 tok/s @ 80k.
# KV is 27 KiB/token (24 KiB attention K+V over the 12 full-attn layers +
# 3 KiB indexer cache); the recurrent (GDN) state is fixed at ~225 MiB. At
# n_ctx 100000 that is ~2.6 GiB KV. The native ceiling n_ctx 262144 also loads,
# so the real limit on long context is prefill time, not VRAM.
ExecStart=/home/agurrrrr/code/golbang/target-cuda/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-Flash-Next-UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf \
  --alias qwen3.8-flash-next \
  --host 0.0.0.0 --port 8090 \
  --n-gpu-layers 99 --n-cpu-moe 42 --flash-attn on \
  --tensor-split 11,1 \
  --n-ctx 100000 --n-batch 4096 --n-ubatch 2048 --n-threads 32 --n-rs-seq 1 \
  --n-parallel 1 --queue-size 2 \
  --jinja --reasoning-format deepseek \
  --model-draft /home/agurrrrr/models/qwen3.8/mtp-flashnext/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf \
  --spec-type draft-mtp --spec-draft-n-max 2 \
  --api-key "${GOLBANG_API_KEY}"
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
MemoryHigh=115G
MemoryMax=122G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
