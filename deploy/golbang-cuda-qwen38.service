[Unit]
Description=golbang OpenAI server - Unsloth Qwen3.8-27B UD-Q4_K_XL + fused MTP (2x V100 CUDA)
After=network.target
Conflicts=qwen3.8-q2.service comfyui-cuda.service qwen3.8-unleashed-q2.service golbang-glm53flash.service ggml-rpc-v100.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HOME=/home/agurrrrr
# Two Tesla V100-SXM2 16 GiB (PCI 41:00.0 + 84:00.0). LAYER split; no NVLink.
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-escha/build/bin:/opt/cuda-12.8/lib64
Environment=RUST_LOG=info
# tensor-split 18,14: 16,16 put 7216/8837 MiB on CUDA0/1 (FA vs GDN sizes).
# 20,12 packed CUDA0 (15989/16384). n-ctx 10000 leaves ~6 GiB/GPU, so
# n-ubatch 1024 fits; 512+PP at ctx 235520 was 1961 MiB and first prefill OOM'd.
# n-ctx 10000 is the per-slot share (KV pool = 10000*2). single-max-ctx
# 10000 keeps a solo slot from growing into the second slot's cells.
ExecStart=/home/agurrrrr/code/golbang/target-cuda/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-UD-Q4_K_XL.gguf \
  --alias qwen3.8-27b-cuda \
  --host 0.0.0.0 --port 8084 \
  --n-gpu-layers 99 --flash-attn on \
  --tensor-split 18,14 \
  --n-ctx 10000 --n-batch 1024 --n-ubatch 1024 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 2 --queue-size 2 --single-max-ctx 10000 --kv-unified \
  --kv-type-k q8_0 --kv-type-v q8_0 \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --spec-draft-p-min 0.0 \
  --no-mmap --jinja --reasoning-format deepseek \
  --reasoning-effort medium \
  --reasoning-budget 2048 \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
