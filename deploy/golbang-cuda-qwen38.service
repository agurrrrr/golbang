[Unit]
Description=golbang OpenAI server - Qwen3.8-27B UD-IQ2_S (RTX 3060 CUDA)
After=network.target
Conflicts=qwen3.8-q2.service comfyui-cuda.service qwen3.8-unleashed-q2.service llama-server.service golbang-deepseek.service golbang-qwen48.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HOME=/home/agurrrrr
Environment=CUDA_VISIBLE_DEVICES=0
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-cuda/build/bin
Environment=RUST_LOG=info
ExecStart=/home/agurrrrr/code/golbang/target/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-UD-IQ2_S.gguf \
  --alias qwen3.8-27b-cuda \
  --host 0.0.0.0 --port 8084 \
  --n-gpu-layers 99 --flash-attn on \
  --n-ctx 40000 --n-batch 512 --n-ubatch 512 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 2 --queue-size 2 --single-max-ctx 64000 --kv-unified \
  --no-mmap --jinja \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
