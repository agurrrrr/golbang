[Unit]
Description=golbang OpenAI server - Unsloth Qwen3.8-27B UD-Q3_K_XL + fused MTP (V100 CUDA)
After=network.target
Conflicts=qwen3.8-q2.service comfyui-cuda.service qwen3.8-unleashed-q2.service golbang-glm53flash.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HOME=/home/agurrrrr
Environment=CUDA_VISIBLE_DEVICES=0
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-escha/build/bin:/opt/cuda-12.8/lib64
Environment=RUST_LOG=info
ExecStart=/home/agurrrrr/code/golbang/target-cuda/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-UD-Q3_K_XL.gguf \
  --alias qwen3.8-27b-cuda \
  --host 0.0.0.0 --port 8084 \
  --n-gpu-layers 99 --flash-attn on \
  --n-ctx 53248 --n-batch 1024 --n-ubatch 512 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 1 --queue-size 1 --single-max-ctx 53248 \
  --kv-type-k q8_0 --kv-type-v q8_0 \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --spec-draft-p-min 0.0 \
  --no-mmap --jinja --reasoning-format deepseek \
  --reasoning-effort medium \
  --reasoning-budget 2048 \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=360
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
