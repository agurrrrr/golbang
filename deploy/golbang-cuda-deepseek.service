[Unit]
Description=golbang OpenAI server - DeepSeek-V4.1-Flash Q2_K (2x V100 CUDA)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-deepseek.service golbang-deepseek-rpc.service golbang-qwen38.service golbang-qwen38-vulkan.service golbang-qwen48.service golbang-glm53flash.service golbang-cuda-qwen38.service ggml-rpc-v100.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HOME=/home/agurrrrr
# Two Tesla V100-SXM2 16 GiB (PCI 41:00.0 + 84:00.0). LAYER split; no NVLink.
# Same 2x V100 pool as golbang-cuda-qwen38 — Conflicts keeps them mutually exclusive.
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-escha/build/bin:/opt/cuda-12.8/lib64
Environment=RUST_LOG=info
# DeepSeek-V4.1-Flash Q2_K (arch deepseek4), 7 shards, 246 GiB file.
# Requires the V4.1 loader patches on the llama.cpp-escha tree (same 5 patches as
# the HIP/glm5next tree: llama-arch.{h,cpp} engram/sparse tensor entries,
# deepseek4.cpp skip_file_tensor + ratio guard + output-hc mean fallback,
# llama-kv-cache.cpp rot guards). See wiki dsv41-on-golbang.
# n-cpu-moe 38 = first 38 MoE layers' experts on CPU; the last 2 (blk.38/39,
# ~10.9 GiB) land entirely on CUDA1. Expert weights (183 GiB) otherwise cannot
# fit 2x16 GiB, so the GPU keeps non-expert weights + KV + those 2 expert layers.
# Tested 2026-09-11: n-cpu-moe 43 and 38 both load; decode is ~equal (9-16 t/s)
# because the bottleneck is the CPU expert GEMV, not the GPU expert layers.
# Measured (n-cpu-moe 38): prefill 6.7->216 t/s (88->3170 tok), decode 9.4->15.8 t/s.
# (n-cpu-moe 36 / 4 GPU expert layers asks CUDA1 for 20.3 GiB -> OOM.)
# tensor-split 16,16: LAYER split, even.
# n-batch 5800 / n-ubatch 1024 / n-parallel 1: same as MI50 production.
# NOTE: output is degraded — engram conditional memory and V4.1 cross-layer sparse
# attention (kv_source/index_source/dspark) are not modeled by the V4 runtime, and
# the early-converted GGUF lacks the engram hash constants. See wiki dsv41-on-golbang.
# This unit is validated for loading + speed only.
ExecStart=/home/agurrrrr/code/golbang/target-cuda/release/golbang-server \
  --model /home/agurrrrr/models/DeepSeek-V4.1-Flash-Q2_K/DeepSeek-V4.1-Flash-Q2_K-00001-of-00007.gguf \
  --alias dsv41-flash-cuda \
  --host 0.0.0.0 --port 8086 \
  --n-gpu-layers 99 --n-cpu-moe 38 --flash-attn on \
  --tensor-split 16,16 \
  --n-ctx 60000 --n-batch 5800 --n-ubatch 1024 --n-threads 32 --n-rs-seq 1 \
  --n-parallel 1 --queue-size 1 \
  --jinja --reasoning-format deepseek \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target