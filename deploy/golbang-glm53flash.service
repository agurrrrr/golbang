[Unit]
Description=golbang OpenAI server - GLM-5.3-Flash AJ-IQ2_XXS (MI50)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-deepseek.service golbang-qwen38.service golbang-qwen48.service golbang-cuda-qwen38.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
EnvironmentFile=-/etc/golbang/secrets.env
Environment=HSA_OVERRIDE_GFX_VERSION=9.0.6
Environment=ROCR_VISIBLE_DEVICES=0
Environment=ROCBLAS_USE_HIPBLASLT=0
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-glm5next/build/bin
Environment=RUST_LOG=info
ExecStartPre=/usr/bin/sudo /home/agurrrrr/code/local-llm/set_gpu_clocks.sh
ExecStart=/home/agurrrrr/code/golbang/target-hip/release/golbang-server \
  --model /home/agurrrrr/models-nas1/GLM-5.3-Flash-GGUF/AJ-IQ2_XXS/GLM-5.3-Flash-AJ-IQ2_XXS-00001-of-00002.gguf \
  --alias glm-5.3-flash \
  --host 0.0.0.0 --port 8085 \
  --n-gpu-layers 99 --n-cpu-moe 42 --flash-attn off \
  --n-ctx 65536 --n-batch 2048 --n-ubatch 512 --n-threads 32 \
  --n-parallel 1 --queue-size 2 \
  --jinja --reasoning-format deepseek --reasoning-effort max \
  --api-key "${GOLBANG_API_KEY_GLM53}"
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target
