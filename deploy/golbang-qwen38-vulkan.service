[Unit]
Description=golbang OpenAI server - Qwen3.8-27B UD-Q4_K_XL 230k q8_0 KV (MI50, Vulkan/RADV)
After=network.target
Conflicts=llama-server.service qwen3.6-27b-q6.service qwen3.8-27b-q6.service golbang-deepseek.service golbang-qwen48.service golbang-glm53flash.service golbang-qwen38.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
EnvironmentFile=-/etc/golbang/secrets.env
# vulkaninfo order on this box: 0=V100(41:00), 1=MI50(83:00), 2=V100(84:00).
# Expose only the MI50 to the Vulkan backend.
Environment=GGML_VK_VISIBLE_DEVICES=1
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-glm5next/build-vulkan/bin
Environment=RUST_LOG=info
ExecStartPre=/usr/bin/sudo /home/agurrrrr/code/local-llm/set_gpu_clocks.sh
ExecStart=/home/agurrrrr/code/golbang/target-vulkan/release/golbang-server \
  --model /home/agurrrrr/models/qwen3.8/Qwen3.8-27B-UD-Q4_K_XL.gguf \
  --alias qwen3.8-27b-vulkan \
  --host 0.0.0.0 --port 8083 \
  --n-gpu-layers 99 --flash-attn on \
  --n-ctx 100000 --n-batch 2048 --n-ubatch 512 --n-threads 8 --n-rs-seq 3 \
  --n-parallel 2 --queue-size 2 --single-max-ctx 100000 --kv-unified \
  --kv-type-k q8_0 --kv-type-v q8_0 \
  --no-mmap --jinja --reasoning-format deepseek \
  --reasoning-effort xhigh --reasoning-budget 4096 \
  --mmproj /home/agurrrrr/models/qwen3.8/mmproj-F16.gguf \
  --spec-type draft-mtp,ngram-mod \
  --spec-draft-n-max 3 \
  --spec-draft-p-min 0.9 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --api-key "${GOLBANG_API_KEY}"
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target