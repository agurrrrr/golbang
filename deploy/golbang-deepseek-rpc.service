[Unit]
Description=golbang OpenAI server - DeepSeek-V4-Flash IQ2_M on MI50 + V100 via ggml-rpc
After=network.target ggml-rpc-v100.service
Requires=ggml-rpc-v100.service
Conflicts=llama-server.service golbang-deepseek.service golbang-qwen38.service golbang-qwen48.service golbang-glm53flash.service golbang-cuda-qwen38.service

[Service]
Type=simple
User=agurrrrr
Group=agurrrrr
WorkingDirectory=/home/agurrrrr/code/golbang
Environment=HSA_OVERRIDE_GFX_VERSION=9.0.6
Environment=ROCR_VISIBLE_DEVICES=0
Environment=ROCBLAS_USE_HIPBLASLT=0
Environment=LD_LIBRARY_PATH=/home/agurrrrr/code/local-llm/llama.cpp-glm5next/build-rpc-hip/bin
Environment=RUST_LOG=info
# Same SHA as production HIP (367ebbc20), sibling cmake dir build-rpc-hip (GGML_RPC=ON).
# n-cpu-moe 28: wiki hetero-gpu-split 26-28 for 1xMI50+1xV100. Raise if VRAM OOM.
# n-ubatch 1024: compute buffer is per device; V100 16 GiB is tight.
ExecStart=/home/agurrrrr/code/golbang/target-hip-rpc/release/golbang-server \
  --model /home/agurrrrr/models/dsv4/UD-IQ2_M/DeepSeek-V4-Flash-0731-UD-IQ2_M-00001-of-00003.gguf \
  --host 0.0.0.0 --port 8080 \
  --n-gpu-layers 99 --n-cpu-moe 28 --flash-attn on \
  --n-ctx 60000 --n-batch 5800 --n-ubatch 1024 --n-threads 32 --n-rs-seq 1 \
  --n-parallel 1 --queue-size 1 \
  --jinja --reasoning-format deepseek \
  --rpc 127.0.0.1:50052 --tensor-split 32,16 \
  --api-key REDACTED_KEY1
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
MemoryMax=120G
MemoryHigh=110G

[Install]
WantedBy=default.target
